{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TimeFold",
  "version": "0.1.0",
  "identifier": "io.github.j-manlans.timefold",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TimeFold",
        "width": 1100,
        "height": 650,
        "minWidth": 400,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "publisher": "Joel Lansgren",
    "windows": {
      "nsis": { "languages": ["Swedish"] }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
